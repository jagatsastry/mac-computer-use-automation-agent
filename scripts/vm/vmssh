#!/bin/bash
# Password-auth SSH into the tart VM (cirruslabs images: admin/admin).
# Used only until setup_vm.sh installs the host's public key; afterwards
# plain `ssh -i ~/.ssh/id_ed25519_agentvm admin@$(tart ip <vm>)` works.
#
# Usage: vmssh <ip> <command...>
set -u
IP="$1"; shift

SSHPASS_BIN="$(command -v sshpass || echo /opt/homebrew/bin/sshpass)"
exec "$SSHPASS_BIN" -p admin ssh \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 \
    -o PreferredAuthentications=password,keyboard-interactive \
    admin@"$IP" "$@"
