# macOS Automation Agent configuration
#
# Current cold reality:
# - Planning still uses Anthropic today.
# - `AGENT_MODEL_PROVIDER` mainly changes the vision backend.
# - The simplest working setup is Anthropic for both planning and vision.

# Required for planning in the current codebase
ANTHROPIC_API_KEY=

# Simplest working path
AGENT_MODEL_PROVIDER=anthropic
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AGENT_ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# Optional local vision path
# AGENT_MODEL_PROVIDER=local
# AGENT_VISION_SERVER_URL=http://localhost:8091
# AGENT_VISION_MODEL=mlx-community/Molmo-7B-D-0924-4bit

# Optional accessibility-first mode
AGENT_USE_ACCESSIBILITY=false

# Runtime behavior
AGENT_ACTION_DELAY=0.5
AGENT_MAX_RETRIES=3
AGENT_MAX_ITERATIONS=20
AGENT_VISION_SERVER_TIMEOUT=300

# Logging and observability
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=logs
AGENT_EVENT_LOG_DIR=logs/runs
AGENT_STATUS_UI=off
