# Automation Agent Configuration

# LLM Configuration
AGENT_OLLAMA_HOST=http://localhost:11434
AGENT_VISION_MODEL=qwen2-vl
AGENT_TEXT_MODEL=gemma2:9b
AGENT_OLLAMA_TIMEOUT=120

# Automation Settings
AGENT_ACTION_DELAY=0.5
AGENT_MAX_RETRIES=3

# Logging
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=logs
AGENT_LOG_STRUCTURED=true

# Safety
AGENT_REQUIRE_CONFIRMATION=false
