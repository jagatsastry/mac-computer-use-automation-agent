# macOS Automation Agent configuration
#
# Three paths: local (free), Anthropic (cloud), or Gemini (cloud).

# --- Local path (Ollama for text, MLX/llama.cpp for vision) ---
# AGENT_MODEL_PROVIDER=local
# AGENT_TEXT_SERVER_URL=http://localhost:11434    # Ollama
# AGENT_TEXT_MODEL=gemma2:9b
# AGENT_VISION_SERVER_URL=http://localhost:8091   # MLX VLM server (Molmo)
# AGENT_VISION_MODEL=molmo

# --- Anthropic path (cloud) ---
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AGENT_ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# --- Gemini path (cloud) ---
# AGENT_MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# AGENT_GEMINI_MODEL=gemini-2.5-flash

# Optional accessibility-first mode
AGENT_USE_ACCESSIBILITY=false

# Runtime behavior
AGENT_ACTION_DELAY=0.5
AGENT_MAX_RETRIES=3
AGENT_MAX_ITERATIONS=20
AGENT_VISION_SERVER_TIMEOUT=300

# Logging and observability
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=logs
AGENT_EVENT_LOG_DIR=logs/runs
AGENT_STATUS_UI=off
